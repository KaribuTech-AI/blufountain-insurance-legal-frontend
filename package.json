{
  "name": "@blufountain/portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-budget.mjs dist 110",
    "lint": "oxlint && npm run lint --workspaces --if-present",
    "preview": "vite preview",
    "test": "vitest run && npm test --workspaces --if-present",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "prepare": "npm run build -w @blufountain/domain",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@blufountain/i18n": "^0.0.0",
    "@blufountain/public-kit": "^0.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@blufountain/domain": "^0.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KaribuTech-AI/blufountain-client.git"
  }
}
